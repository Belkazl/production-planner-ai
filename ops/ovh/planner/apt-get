#!/bin/sh
# OVH staging-only verified bootstrap compatibility shim.
# The system PostgreSQL client was installed by the image build (not by this script).
# Only repeat installations of this already-installed package are short-circuited.
set -eu
real=/usr/bin/apt-get.real
if dpkg-query -W -f='${Status}' postgresql-client 2>/dev/null | grep -qx 'install ok installed'; then
    allowed=yes
    action=none
    client=no
    for item in "$@"; do
        case "$item" in
            update|install)
                if [ "$action" != none ]; then allowed=no; fi
                action=$item
                ;;
            postgresql-client) client=yes ;;
            -y|--yes|-q|-qq|--no-install-recommends) ;;
            *) allowed=no ;;
        esac
    done
    if [ "$allowed" = yes ] && [ "$action" = update ] && [ "$client" = no ]; then
        echo 'OVH_COMPAT_APT_SKIP_UPDATE' >&2
        exit 0
    fi
    if [ "$allowed" = yes ] && [ "$action" = install ] && [ "$client" = yes ]; then
        echo 'OVH_COMPAT_APT_SKIP_INSTALL' >&2
        exit 0
    fi
fi
echo 'OVH_COMPAT_APT_FALLBACK' >&2
exec "$real" "$@"
